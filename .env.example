# MediaHub beta / fjordcopy configuration
# Copy to .env and set a unique random SECRET_KEY before starting.
# Keep this stack in its own LXC: FjordHub app integrations use fixed
# container names and the fjord-net network for SSO and app routing.

COMPOSE_PROJECT_NAME=fjordcopy
APP_PORT=8091
TRAEFIK_HTTP_PORT=80
# The diagnostic dashboard is bound to 127.0.0.1 only.
TRAEFIK_DASHBOARD_PORT=8080

# Absolute paths are required for reliable updates from inside the updater.
DATA_DIR=/opt/fjordcopy-data
APPS_DIR=/opt/fjordcopy-apps
FJORDHUB_HOST_DIR=/opt/fjordcopy
FJORDHUB_IMAGE=fjordcopy-fjordhub:latest

SECRET_KEY=
SESSION_COOKIE_NAME=fjordcopy_session
TZ=Europe/Copenhagen

# Bundled catalogs support this private repository without sharing a token.
# Their app manifests/packages keep the upstream app integration contracts.
# An HTTPS catalog URL can be supplied instead if explicitly desired.
REGISTRY_URL=/app/registry.json
PACKAGES_URL=/app/packages_catalog.json

# Self-updates use origin/main of this repository, never the upstream hub.
FJORDCOPY_REPOSITORY=miklas206/fjordcopy
REPO_BRANCH=main
# For private GitHub access use a dedicated, read-only repository deploy key:
# DATA_DIR/git-ssh/id_ed25519 (mode 600), verified known_hosts (mode 644).
# The updater mounts this directory read-only and enforces host-key checking.

# Optional Proxmox inventory. Configure the target explicitly.
PROXMOX_API_URL=
PROXMOX_NODE=
PROXMOX_VMID=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_SSL=true

# Optional existing app directories on this LXC; fresh installs use APPS_DIR.
FJORDLENS_DIR=
FJORD3D_DIR=
FJORDPARCEL_DIR=

# Optional separate, forced-command Proxmox storage SSH connection.
# Never reuse the repository deploy key for this connection.
FJORDHUB_STORAGE_SSH_HOST=

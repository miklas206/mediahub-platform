{
  "name": "@mediahub/frontend",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 15173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0", "react-dom": "^19.0.0", "react-router-dom": "^7.6.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.5.0", "vite": "^6.4.0", "typescript": "~5.9.3",
    "tailwindcss": "^4.1.0", "@tailwindcss/vite": "^4.1.0",
    "vitest": "^3.2.0", "@playwright/test": "^1.55.0",
    "eslint": "^9.0.0", "@eslint/js": "^9.0.0", "typescript-eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^5.2.0", "globals": "^16.0.0", "prettier": "^3.5.0"
  }
}
